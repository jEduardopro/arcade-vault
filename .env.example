# Copy this file to .env.local and fill in real values. Never put a real value here.

# ---------------------------------------------------------------------------
# Contact form (SPEC 03)
# ---------------------------------------------------------------------------
# None of these three is prefixed with NEXT_PUBLIC_: they are read only inside
# the server action at app/actions/contact.ts and never reach the browser.
#
# Resend rejects example.com outright, so the placeholders below are the real
# sandbox values rather than fake ones — they work as they stand.

# Resend API key. Without it, `next dev` falls back to console mode: the message
# is printed to the server log and the form reports success. In production a
# missing key makes the form return an error instead.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailbox that receives the contact messages. Without a verified domain, Resend
# only accepts the address the account was signed up with, or delivered@resend.dev
# — its test sink, which always reports success and delivers to nobody.
CONTACT_TO_EMAIL=delivered@resend.dev

# Sender. Until a domain of your own is verified in Resend, this has to stay
# onboarding@resend.dev, Resend's shared sandbox sender. Once a domain is
# verified, use an address on it, e.g. "Arcade Vault <hola@midominio.com>".
CONTACT_FROM_EMAIL=Arcade Vault <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# Supabase (SPEC 04)
# ---------------------------------------------------------------------------
# Both are prefixed with NEXT_PUBLIC_ on purpose: the browser client in
# app/lib/supabase/client.ts needs them inside the bundle. Grab them from the
# Supabase dashboard, under Project Settings → API keys.

# API URL of the project, https://<project-ref>.supabase.co.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key (sb_publishable_…). Public by design: it ships to the browser,
# and what actually limits it is Row Level Security on each table. Never put the
# secret key (sb_secret_…) here — it bypasses RLS and belongs to no client bundle.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
